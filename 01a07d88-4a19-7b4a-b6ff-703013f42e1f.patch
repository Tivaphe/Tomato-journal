@@ -259,6 +259,9 @@ button:focus-visible, input:focus-visible, select:focus-visible, textarea:focus-
 .variety-toolbar { display: flex; align-items: center; gap: 12px; margin-bottom: 22px; }
 .filter-chips { display: flex; gap: 7px; overflow-x: auto; padding-bottom: 3px; scrollbar-width: none; }
 .filter-chips::-webkit-scrollbar { display: none; }
+.catalog-filter-controls { flex: 1; min-width: 0; }
+.catalog-filter-controls .filter-chips { flex-wrap: wrap; overflow: visible; }
+.catalog-filter-controls .form-help { display: block; margin-top: 4px; }
 .variety-groups { display: grid; gap: 27px; }
 .variety-group h2 { display: flex; align-items: center; gap: 10px; margin: 0 0 11px; color: var(--muted); font-size: 11px; letter-spacing: .17em; text-transform: uppercase; }
