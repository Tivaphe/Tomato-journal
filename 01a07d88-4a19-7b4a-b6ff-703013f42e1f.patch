@@ -1796,3 +1799,21 @@ body[data-theme="night"] .comparison-table tbody tr:hover { background: #142b22;
 .health-inline-row strong, .health-inline-row small { display: block; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
